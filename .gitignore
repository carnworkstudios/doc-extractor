node_modules
.vscode
.claude

# Build output — produced by `npm run build`. Must NOT be committed:
# stale artifacts shadow fresh CI builds and break Cloudflare deploys
# when the build step is skipped or silently fails.
dist/
Users
test-out
digital-literature-template.html
.DS_Store
*.log
# Anchored to the repo root on purpose: an unanchored `test-*` also matches
# test/test-helpers.mjs, test/test-fixtures/, src/**/test-utils.js and would
# silently drop real suite files from a clone. The committed suite lives in
# test/*.test.mjs and must ship.
/test_*
/test-out/
*.pdf
*.docx
*.doc
*.xlsx
*.pptx
*.xls
test2.js
.playwright-cli

# ── public/ runtime assets ───────────────────────────────────────────────────
# tesseract/ and ort-wasm/ are copied out of node_modules at build time by
# vite-plugin-static-copy (see RUNTIME_ASSET_COPIES in vite.config.js), so they
# are reproducible from package-lock.json and must NOT be committed.
#
# models/ and tessdata/ have NO npm source — they are the only assets that must
# live in git. Without them a fresh CI clone builds a site whose OCR 404s.
public/tesseract/
public/ort-wasm/
scripts
# ── training corpus (NEVER commit) ───────────────────────────────────────────
# Multi-GB derived dataset for the layout+forensics model. Reproducible from
# .training/scripts/, so it is regenerable and must not enter git history.
.training/
